{
  "name": "arth-sutra",
  "version": "1.2.0",
  "description": "Arth Sutra — open-source GST invoice & billing software for India. Tax Invoice, Proforma, Credit Note, Bill of Supply, Delivery Challan, GSTR-1 / GSTR-3B JSON exports, GSTR-2B reconciliation, e-Way Bill, TDS / TCS reports (Form 26Q / 27EQ), multi-currency for 22 countries, per-line custom units, rich-text Terms with 13 India presets, granular backup with optional Google Drive sync. Offline-first PWA. By ARTH.",
  "author": "Arthupadhyay <Contact:arth14deepak@gmail.com>",
  "license": "apche 2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/arthupadhyay/ArthSutra.git"
  },
  "keywords": [
    "gst",
    "gst-invoice",
    "gst-billing-software",
    "arth-sutra-billing",
    "invoice-generator",
    "tax-invoice",
    "billing-software-india",
    "gst-return",
    "gstr-1",
    "gstr-3b",
    "gstr-2b",
    "gstr-2b-reconciliation",
    "gstr-1-json-export",
    "gstr-3b-json-export",
    "tds",
    "tcs",
    "form-26q",
    "form-27eq",
    "section-194q",
    "section-206c",
    "e-way-bill",
    "delivery-challan",
    "credit-note",
    "proforma-invoice",
    "bill-of-supply",
    "pdf-generator",
    "offline-billing",
    "open-source",
    "vyapar-alternative",
    "tally-alternative",
    "zoho-alternative",
    "cleartax-alternative",
    "marg-erp-alternative",
    "mybillbook-alternative",
    "hsn-code",
    "sac-code",
    "uqc",
    "cgst-sgst-igst",
    "place-of-supply",
    "sez-invoice",
    "lut-export-invoice",
    "multi-currency-invoice",
    "international-invoice-india",
    "vat-invoice",
    "upi-qr-invoice",
    "pwa",
    "offline-pwa",
    "freelancer-invoice",
    "small-business-billing",
    "multi-business-profile",
    "multi-gstin",
    "rich-text-terms",
    "india-business-templates",
    "custom-units-invoice",
    "granular-backup",
    "google-drive-backup",
    "searchable-user-guide-pdf",
    "dark-mode-billing",
    "react",
    "vite",
    "expressjs",
    "india",
    "Arth"
  ],
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "server": "node server.js",
    "postinstall": "node scripts/bundle-tesseract-assets.mjs",
    "prebuild": "node scripts/bundle-tesseract-assets.mjs",
    "dev": "node scripts/bundle-tesseract-assets.mjs && node server.js & vite",
    "dev:win": "node scripts/bundle-tesseract-assets.mjs && (start /b node server.js) && vite",
    "build": "vite build",
    "start": "vite build && node server.js",
    "electron:dev": "concurrently -k \"vite\" \"node server.js\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "bundle:tesseract": "node scripts/bundle-tesseract-assets.mjs",
    "db:migrate": "node scripts/migrate-json-to-sqlite.js",
    "test": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "dompurify": "^3.3.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "fast-levenshtein": "^3.0.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.4",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.35.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.arth.sutra",
    "productName": "ArthSutra",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "db/**/*",
      "utils/**/*",
      "plugins/**/*",
      "src/utils.js",
      "package.json",
      "!data/**/*",
      "!.env*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ArthSutra"
    }
  }
}
